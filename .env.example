OPENALEX_API_KEY=
TAVILY_API_KEY=

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
ENABLE_SKILLS=true

# Per-question search budget = queries * rounds.
MAX_SEARCH_QUERIES=2
MAX_RESEARCH_ROUNDS=1
MAX_SOURCES=5
MIN_REQUIRED_SOURCES=3

# Recommended to benchmark context window and output tokens for your model and specific hardware.
CONTEXT_WINDOW=8192
OUTPUT_TOKENS=3072
# Blank derives search budget + 12; explicit values cap model calls per question.
AGENT_MAX_TURNS=

# Search/evidence payloads. Blank results-per-query follows MAX_SOURCES.
SEARCH_RESULTS_PER_QUERY=5

# Application query-length validation; rejects oversized queries without truncation.
MAX_QUERY_CHARS=1500
SEARCH_SNIPPET_CHARS=700
EVIDENCE_PAGE_CHARS=2000
EVIDENCE_CATALOGUE_PAGE_SIZE=20
